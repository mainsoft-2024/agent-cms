  "scripts": {
    "build": "tsup && tsx scripts/build-registry.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:db": "tsx --test src/db/*.test.ts",
    "test:s3": "tsx --test src/storage-s3.test.ts",
    "s3:dev": "bash scripts/s3-dev.sh",
    "test:ui": "tsx --tsconfig registry/tsconfig.json --test registry/__tests__/*.test.tsx",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "check:pack": "publint --strict && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:registry": "tsx scripts/build-registry.ts",
    "test:shadcn": "bash scripts/shadcn-smoke.sh"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
