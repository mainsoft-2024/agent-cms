{
  "name": "@mainsoft/agent-cms",
  "version": "0.10.1",
  "description": "An add-on CMS that runs inside your web app, edited by people (admin UI) and AI agents (MCP, REST, CLI) together.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mainsoft-2024/agent-cms.git"
  },
  "homepage": "https://github.com/mainsoft-2024/agent-cms#readme",
  "author": "Paul Park <2000mageia@gmail.com>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "UPGRADE-0.6.md",
    "UPGRADE-0.8.md",
    "UPGRADE-0.10.md",
    "CHANGELOG.md",
    "TODO.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "bin": {
    "agent-cms": "dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
